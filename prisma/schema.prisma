// RankForge SEO — Advanced Multi-Domain SEO Optimization Platform
// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A business domain / industry category (top-level tab)
model Domain {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  icon        String
  color       String
  accent      String
  createdAt   DateTime @default(now())
  companies   Company[]
}

// A company / website tracked within a domain — gets its own dedicated page
model Company {
  id          String   @id @default(cuid())
  domainId    String
  name        String
  slug        String
  website     String
  logoText    String
  description String
  location    String
  employees   String
  foundedYear Int
  industry    String
  createdAt   DateTime @default(now())

  domain      Domain     @relation(fields: [domainId], references: [id], onDelete: Cascade)
  metrics     SeoMetric[]
  keywords    Keyword[]
  backlinks   Backlink[]
  competitors Competitor[]
  issues      TechnicalIssue[]
  contentGaps ContentGap[]
  insights    SeoInsight[]
  webVitals   CoreWebVital[]
  serpFeatures SerpFeature[]
  client      Client?

  @@unique([domainId, slug])
}

// A client/owner of a company — onboarded via the wizard, gets a unique portal link
model Client {
  id           String   @id @default(cuid())
  companyId    String   @unique
  name         String
  email        String
  phone        String?
  role         String   @default("Owner") // Owner | Marketing Manager | SEO Specialist | Agency
  token        String   @unique @default(cuid()) // unique shareable link token
  primaryGoal  String   // Increase organic traffic | Rank #1 for keywords | Grow backlinks | Improve technical SEO
  targetKeywords Int    @default(50)
  targetTraffic  Int    @default(0)
  targetDA       Float  @default(0)
  onboardedAt  DateTime @default(now())
  lastVisit    DateTime?

  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goals        ClientGoal[]
  tasks        ClientTask[]

  @@index([email])
}

// Client-set goals with target + current progress
model ClientGoal {
  id          String   @id @default(cuid())
  clientId    String
  type        String   // traffic | keywords | backlinks | authority | position | visibility
  label       String
  target      Float
  current     Float
  deadline    DateTime?
  status      String   @default("active") // active | achieved | overdue
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Client action tasks / to-do list
model ClientTask {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  description String?
  category    String   @default("optimization") // optimization | content | technical | outreach | monitoring
  priority    String   @default("medium") // high | medium | low
  status      String   @default("todo") // todo | in-progress | done
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Time-series SEO metric snapshot (one per day per company)
model SeoMetric {
  id              String   @id @default(cuid())
  companyId       String
  date            DateTime
  organicTraffic  Int
  keywordsRanked  Int
  backlinks       Int
  referringDomains Int
  domainAuthority Float
  pageAuthority   Float
  avgPosition     Float
  visibilityScore Float
  organicClicks   Int
  impressions     Int
  ctr             Float
  bounceRate      Float
  avgLoadTime     Float

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
}

// Tracked keyword with rank position + 30-day trend
model Keyword {
  id             String   @id @default(cuid())
  companyId      String
  keyword        String
  position       Int
  previousPosition Int
  searchVolume   Int
  difficulty     Float
  cpc            Float
  intent         String
  url            String
  trend          String   // JSON array of {date, position}
  updatedAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Backlink profile entry
model Backlink {
  id            String   @id @default(cuid())
  companyId     String
  sourceDomain  String
  sourceUrl     String
  anchorText    String
  domainAuthority Float
  linkType      String   // dofollow | nofollow
  status        String   // active | lost | new
  firstSeen     DateTime
  traffic       Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Competitor analysis entry
model Competitor {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  domain          String
  domainAuthority Float
  organicTraffic Int
  commonKeywords  Int
  trafficOverlap  Float    // 0..1
  backlinks       Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Technical SEO audit issue
model TechnicalIssue {
  id           String   @id @default(cuid())
  companyId    String
  type         String   // e.g. core-web-vitals, crawlability, mobile, schema, security
  severity     String   // critical | warning | info
  title        String
  description  String
  affectedCount Int
  status       String   // open | resolved
  detectedAt   DateTime

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Content gap opportunity — keyword competitors rank for that the company doesn't
model ContentGap {
  id              String   @id @default(cuid())
  companyId       String
  keyword         String
  competitorRanking String // comma separated competitor names
  searchVolume    Int
  difficulty      Float
  opportunity     Float    // 0..100 opportunity score

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// AI-generated SEO insight / recommendation
model SeoInsight {
  id        String   @id @default(cuid())
  companyId String
  type      String   // opportunity | warning | action | competitive
  title     String
  content   String
  priority  String   // high | medium | low
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Core Web Vitals — per-URL performance measurements (LCP, FID, CLS, INP, TTFB, FCP)
model CoreWebVital {
  id        String   @id @default(cuid())
  companyId String
  url       String
  device    String   // mobile | desktop
  lcp       Float    // Largest Contentful Paint (seconds)
  fid       Float    // First Input Delay (ms)
  cls       Float    // Cumulative Layout Shift (unitless)
  inp       Float    // Interaction to Next Paint (ms)
  ttfb      Float    // Time to First Byte (ms)
  fcp       Float    // First Contentful Paint (seconds)
  score     Float    // 0..100 overall CWV score
  status    String   // good | needs-improvement | poor
  updatedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// SERP feature tracking — which rich results / features the company captures
model SerpFeature {
  id        String   @id @default(cuid())
  companyId String
  type      String   // featured-snippet | sitelinks | reviews | faq | video | image-pack | local-pack | top-stories | people-also-ask
  keyword   String
  url       String
  captured  Boolean  @default(true)
  competitorOwned Boolean @default(false) // true if a competitor owns this feature
  updatedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}
