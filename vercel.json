    "src/app/api/client/[token]/multicrawl/route.ts": { "maxDuration": 60 },
    "src/app/api/client/[token]/daily-crawl/route.ts": { "maxDuration": 60 },
    "src/app/api/client/[token]/pagespeed/route.ts": { "maxDuration": 60 },
    "src/app/api/client/[token]/write-content/route.ts": { "maxDuration": 60 },
